// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Project {
  id               String   @id @default(cuid())
  title            String
  location         String?
  category         String
  shortDescription String?
  completionYear   String?
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  images           Image[]
}

model Image {
  id                 String   @id @default(cuid())
  url                String
  cloudinaryPublicId String?
  altText            String?
  category           String?  // For gallery categorization
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  client    String
  company   String?
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  key       String   @id // e.g. "hero_main_heading", "seo_home_title"
  value     String
  updatedAt DateTime @updatedAt
}

model Service {
  id           String   @id @default(cuid())
  title        String
  description  String
  specs        String   // JSON stringified array of strings
  icon         String   // Lucide icon name
  glow         String   
  accent       String   
  overview     String
  features     String   // JSON stringified array of strings
  applications String   // JSON stringified array of strings
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
